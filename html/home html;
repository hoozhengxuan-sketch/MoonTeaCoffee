<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MoonTea Coffee | Home</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Roboto&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="home.css">
</head>
<body>
  <header>
    <img src="logo.png" alt="MoonTea Coffee Logo" class="logo">
    <h1>MoonTea Coffee</h1>
    <nav>
      <a href="home.html">Home</a>
      <a href="menu.html">Menu</a>
      <a href="about.html">About Us</a>
      <a href="portfolio.html">Team Portfolio</a>
    </nav>
    <button id="theme-toggle">🌙 Toggle Theme</button>
  </header>

  <main>
    <section class="hero fade-in">
      <h2>Welcome to MoonTea Coffee</h2>
      <p>Night-inspired bubble tea and coffee crafted for calm, cosy evenings.</p>
      <button id="explore-btn">Explore Our Menu</button>
    </section>

    <section class="why fade-in">
      <h2>Why MoonTea Coffee?</h2>
      <p>We specialise in evening-friendly blends with lower caffeine, soothing flavours, and a cosy ambience designed for relaxation.</p>
    </section>

    <section class="reviews fade-in">
      <h2>Customer Reviews</h2>
      <form id="review-form">
        <label for="rating">Rate us:</label>
        <select id="rating" required>
          <option value="">Select</option>
          <option value="⭐">⭐</option>
          <option value="⭐⭐">⭐⭐</option>
          <option value="⭐⭐⭐">⭐⭐⭐</option>
          <option value="⭐⭐⭐⭐">⭐⭐⭐⭐</option>
          <option value="⭐⭐⭐⭐⭐">⭐⭐⭐⭐⭐</option>
        </select>
        <textarea id="review-text" placeholder="Write your review..." required></textarea>
        <button type="submit">Submit Review</button>
      </form>
      <div id="reviews-list"></div>
    </section>
  </main>

  <footer>
    <p>&copy; 2026 MoonTea Coffee. All rights reserved.</p>
  </footer>

  <script src="script.js"></script>
</body>
</html>
