<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Menu | MoonTea Coffee</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Roboto&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="menu.css">
</head>
<body>
  <header>
    <h1>MoonTea Coffee</h1>
    <nav aria-label="Main navigation">
      <a href="home.html">Home</a>
      <a href="menu.html">Menu</a>
      <a href="about.html">About Us</a>
      <a href="member.html">Members</a>
      <a href="portfolio.html">Team Portfolio</a>
    </nav>
    <button id="theme-toggle" aria-label="Toggle theme">🌙 Toggle Theme</button>
  </header>

  <main>
    <section class="menu-hero fade-in">
      <h2>Our Menu</h2>
      <p>Signature drinks crafted with love.</p>
    </section>

    <section class="menu-controls">
      <input type="text" id="search" placeholder="Search drinks..." aria-label="Search drinks">
      <select id="filter">
        <option value="all">All Categories</option>
        <option value="coffee">Coffee</option>
        <option value="tea">Tea</option>
        <option value="special">Special</option>
      </select>
      <select id="sort">
        <option value="name">Sort by Name</option>
        <option value="price">Sort by Price</option>
      </select>
    </section>

    <section class="menu-container" id="menu-container">
      <!-- Drinks dynamically rendered -->
    </section>
  </main>

  <footer>
    <p>&copy; 2026 MoonTea Coffee. All rights reserved.</p>
  </footer>

  <script src="script.js"></script>
</body>
</html>
