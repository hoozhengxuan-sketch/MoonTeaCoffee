</html>
<!-- Birthday & Terms -->
<div class="form-step" data-step-content="3">
    <h2 class="step-title">Step 3: Membership Preferences</h2>

    <div class="form-group">
        <label for="regDob">Date of Birth <span class="required">*</span></label>
        <div class="input-wrapper">
            <i class="fas fa-calendar-alt input-icon"></i>
            <input type="date" id="regDob" required aria-describedby="errDob">
        </div>
        <small class="error-msg" id="errDob"></small>
    </div>

    <div class="form-group checkbox-group">
        <label class="custom-checkbox-label">
            <input type="checkbox" id="regTerms">
            <span class="checkbox-custom"></span>
            I agree to the <a href="#" class="inline-link">Terms & Conditions</a> and Privacy Policy <span class="required">*</span>
        </label>
        <small class="error-msg" id="errTerms"></small>
    </div>

    <div class="form-group checkbox-group">
        <label class="custom-checkbox-label">
            <input type="checkbox" id="regNewsletter" checked>
            <span class="checkbox-custom"></span>
            Send me exclusive discounts and promotion alerts via email.
        </label>
    </div>
</div>

<!-- Form Controls -->
<div class="form-navigation">
    <button type="button" class="btn btn-secondary" id="prevBtn" style="display: none;">
        <i class="fas fa-arrow-left"></i> Previous
    </button>
    <button type="button" class="btn btn-primary" id="nextBtn">
        Next Step <i class="fas fa-arrow-right"></i>
    </button>
    <button type="submit" class="btn btn-primary" id="submitRegBtn" style="display: none;">
        Complete Registration <i class="fas fa-check"></i>
    </button>
</div>
</form>

<!-- ================= LOGIN ================= -->
<form id="loginForm" class="auth-form" novalidate>
    <h2 class="step-title">Welcome Back!</h2>
    <p class="login-subtext">Sign in to check your Moon Points and active vouchers.</p>

    <div class="form-group">
        <label for="loginEmail">Email / Username <span class="required">*</span></label>
        <div class="input-wrapper">
            <i class="fas fa-envelope input-icon"></i>
            <input type="text" id="loginEmail" placeholder="Enter your email or username" required aria-describedby="errLoginEmail">
        </div>
        <small class="error-msg" id="errLoginEmail"></small>
    </div>

    <div class="form-group">
        <label for="loginPassword">Password <span class="required">*</span></label>
        <div class="input-wrapper">
            <i class="fas fa-lock input-icon"></i>
            <input type="password" id="loginPassword" placeholder="Enter your password" required aria-describedby="errLoginPassword">
        </div>
        <small class="error-msg" id="errLoginPassword"></small>
    </div>

    <button type="submit" class="btn btn-primary btn-block">
        Sign In <i class="fas fa-sign-in-alt"></i>
    </button>
</form>

<!-- Greeting -->
<div id="greetingContainer" class="greeting-box hidden" aria-live="polite">
    <div class="greeting-icon"><i class="fas fa-moon"></i></div>
    <h2 id="greetingTitle">Welcome Back, Moonlight Member!</h2>
    <p id="greetingMessage">We are brewing your favorite drink with calm and comfort today.</p>
    
    <div class="member-stats">
        <div class="stat-item">
            <span class="stat-number" id="userPoints">150</span>
            <span class="stat-label">Moon Points</span>
        </div>
        <div class="stat-item">
            <span class="stat-number" id="userTier">Gold</span>
            <span class="stat-label">Member Tier</span>
        </div>
    </div>

    <button type="button" class="btn btn-secondary" id="logoutBtn">
        <i class="fas fa-sign-out-alt"></i> Log Out
    </button>
</div>

</section>
</main>

