/* portfolio.css - MoonTea Coffee */

:root {
  --primary-color: #3e2c2c;
  --accent-color: #f0c674;
  --bg-color: #fdfcf7;
  --text-color: #333;
}

body {
  margin: 0;
  font-family: 'Roboto', sans-serif;
  background-color: var(--bg-color);
  color: var(--text-color);
  transition: background-color 0.3s ease, color 0.3s ease;
}

header {
  background: var(--primary-color);
  color: #fff;
  padding: 1rem;
  text-align: center;
}

nav a {
  color: #fff;
  margin: 0 1rem;
  text-decoration: none;
  transition: color 0.3s ease;
}

nav a:hover {
  color: var(--accent-color);
}

button {
  background: var(--accent-color);
  border: none;
  padding: 0.5rem 1rem;
  cursor: pointer;
  transition: transform 0.3s ease;
}

button:hover {
  transform: scale(1.05);
}

.portfolio-hero {
  background: url('portfolio-banner.jpg') no-repeat center center/cover;
  color: #fff;
  padding: 5rem 2rem;
  text-align: center;
}

.portfolio-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
  padding: 3rem 2rem;
}

.portfolio-card {
  background: #fff;
  border: 1px solid #ddd;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 4px 6px rgba(0,0,0,0.1);
  transition: transform 0.3s ease;
  text-align: center;
}

.portfolio-card:hover {
  transform: translateY(-5px);
}

.portfolio-card img {
  width: 100%;
  height: auto;
}

.portfolio-card h3 {
  font-family: 'Playfair Display', serif;
  margin: 1rem 0 0.5rem;
  color: var(--primary-color);
}

.details {
  margin-top: 1rem;
  text-align: left;
  font-size: 0.9rem;
  padding: 0 1rem;
}

.hidden {
  display: none;
}

.fade-in {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}

.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

footer {
  background: var(--primary-color);
  color: #fff;
  text-align: center;
  padding: 1rem;
}

.dark-theme {
  --bg-color: #222;
  --text-color: #fdfcf7;
  --primary-color: #111;
  --accent-color: #c9a227;
}
