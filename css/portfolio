@import url('homepage.css');

.team {
    padding: 2rem;
}

.team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
}

.member-card {
    background-color: var(--accent);
    padding: 1rem;
    border-radius: 8px;
    text-align: center;
}

.member-card img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
}

