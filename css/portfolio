/* portfolio.css - Moon Tea Coffee */

body {
  margin: 0;
  font-family: 'Roboto', sans-serif;
  background-color: #fdfcf7;
  color: #333;
}

/* Header */
header {
  background: #3e2c2c;
  color: #fff;
  padding: 1rem;
  text-align: center;
}

header h1 {
  font-family: 'Playfair Display', serif;
  margin: 0;
}

nav {
  margin-top: 0.5rem;
}

nav a {
  color: #fff;
  margin: 0 1rem;
  text-decoration: none;
  transition: color 0.3s ease;
}

nav a:hover {
  color: #f0c674;
}

/* Hero Section */
.portfolio-hero {
  background: url('portfolio-banner.jpg') no-repeat center center/cover;
  color: #fff;
  padding: 5rem 2rem;
  text-align: center;
}

.portfolio-hero h2 {
  font-size: 2.5rem;
  margin: 0;
}

.portfolio-hero p {
  font-size: 1.2rem;
  margin-top: 1rem;
}

/* Portfolio Grid */
.portfolio-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
  padding: 3rem 2rem;
}

.portfolio-card {
  background: #fff;
  border: 1px solid #ddd;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 4px 6px rgba(0,0,0,0.1);
  transition: transform 0.3s ease;
  text-align: center;
}

.portfolio-card:hover {
  transform: translateY(-5px);
}

.portfolio-card img {
  width: 100%;
  height: auto;
}

.portfolio-card h3 {
  font-family: 'Playfair Display', serif;
  margin: 1rem 0 0.5rem;
  color: #3e2c2c;
}

.portfolio-card p {
  margin: 0 1rem 1rem;
  line-height: 1.4;
}

/* Footer */
footer {
  background: #3e2c2c;
  color: #fff;
  text-align: center;
  padding: 1rem;
  font-size: 0.9rem;
}

/* Responsive */
@media (max-width: 768px) {
  .portfolio-hero {
    padding: 3rem 1rem;
  }

  .portfolio-hero h2 {
    font-size: 2rem;
  }
}
