/* ===========================
   VARIABLES
=========================== */
:root {
    --primary: #2b2d42;
    --secondary: #8d99ae;
    --accent: #edf2f4;
    --text-light: #ffffff;
    --text-dark: #2b2d42;

    --spacing-sm: 0.5rem;
    --spacing-md: 1rem;
    --spacing-lg: 2rem;

    --radius: 6px;
    --transition: 0.3s ease;
}

/* ===========================
   GLOBAL RESET
=========================== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: var(--accent);
    color: var(--text-dark);
    line-height: 1.6;
}

/* ===========================
   HEADER
=========================== */
header {
    background-color: var(--primary);
    color: var(--text-light);
    padding: var(--spacing-md);
}

.nav-links {
    list-style: none;
    display: flex;
    gap: var(--spacing-md);
}

.nav-links a {
    color: var(--text-light);
    text-decoration: none;
    font-weight: bold;
    padding: 0.3rem 0.5rem;
    border-radius: var(--radius);
    transition: var(--transition);
}

.nav-links a:hover {
    background-color: var(--secondary);
}

/* ===========================
   BIO SECTION
=========================== */
.bio {
    max-width: 900px;
    margin: var(--spacing-lg) auto;
    padding: var(--spacing-md);
    background-color: var(--text-light);
    border-radius: var(--radius);
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    animation: fadeIn 1s ease-in-out;
}

/* ===========================
   EDUCATION
=========================== */
.education {
    max-width: 900px;
    margin: var(--spacing-lg) auto;
    padding: var(--spacing-md);
}

/* ===========================
   SKILLS (CSS Progress Bars)
=========================== */
.skills {
    max-width: 900px;
    margin: var(--spacing-lg) auto;
    padding: var(--spacing-md);
}

.skill {
    margin-bottom: var(--spacing-md);
}

.skill-bar {
    background-color: var(--secondary);
    height: 12px;
    border-radius: var(--radius);
    overflow: hidden;
}

.skill-fill {
    height: 100%;
    background-color: var(--primary);
    width: 0;
    animation: fillBar 2s forwards;
}

.htmlcss { width: 90%; }
.js { width: 70%; }

@keyframes fillBar {
    from { width: 0; }
    to { width: var(--target-width); }
}

/* ===========================
   PROJECTS
=========================== */
.projects {
    max-width: 900px;
    margin: var(--spacing-lg) auto;
    padding: var(--spacing-md);
}

/* ===========================
   CV BUTTON
=========================== */
.cv button {
    padding: 0.8rem 1.5rem;
    background-color: var(--primary);
    color: var(--text-light);
    border: none;
    border-radius: var(--radius);
    cursor: pointer;
    transition: var(--transition);
}

.cv button:hover {
    background-color: var(--secondary);
}

/* ===========================
   FOOTER
=========================== */
footer {
    background-color: var(--primary);
    color: var(--text-light);
    text-align: center;
    padding: var(--spacing-md);
    margin-top: var(--spacing-lg);
}

/* ===========================
   PRINT STYLESHEET
=========================== */
@media print {
    header, footer, nav {
        display: none;
    }

    body {
        background: white;
        color: black;
    }

    .bio, .education, .skills, .projects {
        box-shadow: none;
        border: none;
    }
}
