/* member.css - Moon Tea Coffee */

body {
  margin: 0;
  font-family: 'Roboto', sans-serif;
  background-color: #fdfcf7;
  color: #333;
}

/* Header */
header {
  background: #3e2c2c;
  color: #fff;
  padding: 1rem;
  text-align: center;
}

header h1 {
  font-family: 'Playfair Display', serif;
  margin: 0;
}

nav {
  margin-top: 0.5rem;
}

nav a {
  color: #fff;
  margin: 0 1rem;
  text-decoration: none;
  transition: color 0.3s ease;
}

nav a:hover {
  color: #f0c674;
}

/* Hero Section */
.team-hero {
  background: url('team-banner.jpg') no-repeat center center/cover;
  color: #fff;
  padding: 5rem 2rem;
  text-align: center;
}

.team-hero h2 {
  font-size: 2.5rem;
  margin: 0;
}

.team-hero p {
  font-size: 1.2rem;
  margin-top: 1rem;
}

/* Team Cards */
.team-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  padding: 3rem 2rem;
  gap: 2rem;
}

.team-card {
  background: #fff;
  border: 1px solid #ddd;
  border-radius: 8px;
  width: 280px;
  padding: 1.5rem;
  text-align: center;
  box-shadow: 0 4px 6px rgba(0,0,0,0.1);
  transition: transform 0.3s ease;
}

.team-card:hover {
  transform: translateY(-5px);
}

.team-card img {
  width: 100%;
  height: auto;
  border-radius: 50%;
  margin-bottom: 1rem;
}

.team-card h3 {
  font-family: 'Playfair Display', serif;
  margin: 0.5rem 0;
  color: #3e2c2c;
}

.team-card p {
  margin: 0.5rem 0;
  line-height: 1.4;
}

/* Footer */
footer {
  background: #3e2c2c;
  color: #fff;
  text-align: center;
  padding: 1rem;
  font-size: 0.9rem;
}

/* Responsive */
@media (max-width: 768px) {
  .team-container {
    flex-direction: column;
    align-items: center;
  }

  .team-card {
    width: 90%;
  }

  .team-hero {
    padding: 3rem 1rem;
  }

  .team-hero h2 {
    font-size: 2rem;
  }
}
