@import url('homepage.css');

main {
    padding: 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
}

.bio {
    grid-column: 1 / -1;
}

.skills .skill {
    margin-bottom: 1rem;
}

.skill-bar {
    width: 100%;
    height: 10px;
    background-color: var(--secondary);
    border-radius: 5px;
    overflow: hidden;
}

.skill-fill {
    height: 100%;
    background-color: var(--primary);
    transition: width 0.5s ease;
}

.skill-fill.htmlcss {
    width: 80%;
}

.skill-fill.js {
    width: 60%;
}

.cv button {
    padding: 0.8rem 1.5rem;
    background-color: var(--primary);
    color: var(--text-light);
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: transform 0.2s ease;
}

.cv button:hover {
    transform: scale(1.05);
}

