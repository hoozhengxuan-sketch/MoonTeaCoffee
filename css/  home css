/* index.css - Moon Tea Coffee */

body {
  margin: 0;
  font-family: 'Roboto', sans-serif;
  background-color: #fdfcf7;
  color: #333;
}

/* Header */
header {
  background: #3e2c2c;
  color: #fff;
  padding: 1rem;
  text-align: center;
}

header h1 {
  font-family: 'Playfair Display', serif;
  margin: 0;
}

nav {
  margin-top: 0.5rem;
}

nav a {
  color: #fff;
  margin: 0 1rem;
  text-decoration: none;
  transition: color 0.3s ease;
}

nav a:hover {
  color: #f0c674;
}

/* Hero Section */
.hero {
  background: url('coffee-banner.jpg') no-repeat center center/cover;
  color: #fff;
  padding: 6rem 2rem;
}

.hero h2 {
  font-size: 2.5rem;
  margin: 0;
}

.hero p {
  font-size: 1.2rem;
  margin-top: 1rem;
}

