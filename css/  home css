:root {
    --primary: #6C63FF;
    --primary-light: #8D86FF;
    --primary-dark: #4E48CC;
    --secondary: #F4F4FF;
    --white: #ffffff;
    --gray-light: #f5f0eb;
    --text-dark: #1e1e1e;
    --shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    --radius: 24px;
}

body {
    background-color: #F4F4FF;
    color: #2d2d2d;
    line-height: 1.6;
}

/* HERO */
.hero {
    background: linear-gradient(145deg, #dcdcff 0%, #c8c8ff 100%);
    border-radius: var(--radius);
    margin: 28px 0 40px;
    padding: 50px 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    box-shadow: var(--shadow);
    position: relative;
    overflow: hidden;
}

.hero::before {
    content: '🌙';
    font-size: 14rem;
    position: absolute;
    right: -20px;
    bottom: -40px;
    opacity: 0.08;
    transform: rotate(12deg);
    pointer-events: none;
}

/* Highlight glow */
.hero-content h1 .highlight::after {
    background: rgba(108, 99, 255, 0.25);
}

/* Footer (optional navy theme) */
.footer {
    background: #0A0A1A;
    color: #ccc;
    padding: 40px 0 28px;
    margin-top: 50px;
    border-radius: 40px 40px 0 0;
}
