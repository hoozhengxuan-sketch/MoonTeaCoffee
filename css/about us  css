/* about.css - Moon Tea Coffee */

body {
  margin: 0;
  font-family: 'Roboto', sans-serif;
  background-color: #fdfcf7;
  color: #333;
}

/* Header */
header {
  background: #3e2c2c;
  color: #fff;
  padding: 1rem;
  text-align: center;
}

header h1 {
  font-family: 'Playfair Display', serif;
  margin: 0;
}

nav {
  margin-top: 0.5rem;
}

nav a {
  color: #fff;
  margin: 0 1rem;
  text-decoration: none;
  transition: color 0.3s ease;
}

nav a:hover {
  color: #f0c674;
}

/* Hero Section */
.about-hero {
  background: url('about-banner.jpg') no-repeat center center/cover;
  color: #fff;
  padding: 5rem 2rem;
  text-align: center;
}

.about-hero h2 {
  font-size: 2.5rem;
  margin: 0;
}

.about-hero p {
  font-size: 1.2rem;
  margin-top: 1rem;
}

/* Content Section */
.about-content {
  padding: 3rem 2rem;
  max-width: 800px;
  margin: 0 auto;
  text-align: left;
}

.about-content h2 {
  font-family: 'Playfair Display', serif;
  font-size: 2rem;
  margin-top: 2rem;
  margin-bottom: 1rem;
  color: #3e2c2c;
}

.about-content p {
  line-height: 1.6;
}

.about-content ul {
  list-style: none;
  padding: 0;
}

.about-content li {
  margin: 0.5rem 0;
  font-size: 1.1rem;
}

/* Footer */
footer {
  background: #3e2c2c;
  color: #fff;
  text-align: center;
  padding: 1rem;
  font-size: 0.9rem;
}

/* Responsive */
@media (max-width: 768px) {
  .about-hero {
    padding: 3rem 1rem;
  }

  .about-hero h2 {
    font-size: 2rem;
  }

  .about-content {
    padding: 2rem 1rem;
  }
}

