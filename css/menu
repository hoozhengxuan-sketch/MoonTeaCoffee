/* menu.css - MoonTea Coffee */

:root {
  --primary-color: #3e2c2c;
  --accent-color: #f0c674;
  --bg-color: #fdfcf7;
  --text-color: #333;
}

body {
  margin: 0;
  font-family: 'Roboto', sans-serif;
  background-color: var(--bg-color);
  color: var(--text-color);
  transition: background-color 0.3s ease, color 0.3s ease;
}

header {
  background: var(--primary-color);
  color: #fff;
  padding: 1rem;
  text-align: center;
}

nav a {
  color: #fff;
  margin: 0 1rem;
  text-decoration: none;
  transition: color 0.3s ease;
}

nav a:hover {
  color: var(--accent-color);
}

button, select, input {
  margin: 0.5rem;
  padding: 0.5rem;
}

.menu-hero {
  background: url('menu-banner.jpg') no-repeat center center/cover;
  color: #fff;
  padding: 5rem 2rem;
  text-align: center;
}

.menu-controls {
  text-align: center;
  margin: 1rem;
}

.menu-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  padding: 2rem;
  gap: 2rem;
}

.menu-card {
  background: #fff;
  border: 1px solid #ddd;
  border-radius: 8px;
  width: 220px;
  padding: 1rem;
  text-align: center;
  box-shadow: 0 4px 6px rgba(0,0,0,0.1);
  transition: transform 0.3s ease;
}

.menu-card:hover {
  transform: translateY(-5px);
}

.menu-card h3 {
  font-family: 'Playfair Display', serif;
  color: var(--primary-color);
}

.price {
  font-weight: bold;
  color: var(--accent-color);
}

.fade-in {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}

.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

footer {
  background: var(--primary-color);
  color: #fff;
  text-align: center;
  padding: 1rem;
}

.dark-theme {
  --bg-color: #222;
  --text-color: #fdfcf7;
  --primary-color: #111;
  --accent-color: #c9a227;
}
